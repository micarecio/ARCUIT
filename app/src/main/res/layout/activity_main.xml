<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/background_gradient">

    <!-- Camera area -->
    <FrameLayout
        android:id="@+id/camera_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <com.sd.arcuit.OverlayView
            android:id="@+id/overlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- Right-side buttons panel -->
    <ScrollView
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#1A1A1A"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="top|center_horizontal">

            <!-- Torch Button -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnTorch"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_flash_off"
                    android:tint="#00FFCC"
                    android:backgroundTint="#1A1A1A"
                    android:contentDescription="Toggle Flash"
                    app:fabCustomSize="64dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginTop="70dp"
                    android:text="Flash"
                    android:textColor="#00FFCC"
                    android:textSize="12sp" />
            </FrameLayout>

            <!-- Detection Button -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnDetection"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_detection"
                    android:tint="#00FFCC"
                    android:backgroundTint="#1A1A1A"
                    android:contentDescription="Detection Layer"
                    app:fabCustomSize="64dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginTop="70dp"
                    android:text="Detect"
                    android:textColor="#00FFCC"
                    android:textSize="12sp" />
            </FrameLayout>

            <!-- Circuit Diagram Button -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnCircuit"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_circuit"
                    android:tint="#00FFCC"
                    android:backgroundTint="#1A1A1A"
                    android:contentDescription="Circuit Diagram Layer"
                    app:fabCustomSize="64dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginTop="70dp"
                    android:text="Circuit"
                    android:textColor="#00FFCC"
                    android:textSize="12sp" />
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>