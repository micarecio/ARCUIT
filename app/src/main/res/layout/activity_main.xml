<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Full camera background -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Full overlay -->
    <com.sd.arcuit.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Detection guide area -->
    <FrameLayout
        android:id="@+id/detectionGuideContainer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginEnd="96dp"
        android:background="@android:color/transparent"
        android:clickable="false"
        android:focusable="false">
    </FrameLayout>

    <!-- AR-like floating IC selector -->
    <FrameLayout
        android:id="@+id/icSelectorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:background="@android:color/transparent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/icSelectorCard"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardBackgroundColor="#66111111"
            app:cardCornerRadius="18dp"
            app:cardElevation="12dp"
            app:strokeColor="#00FFFF"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/txtIcSelectorTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select IC"
                    android:textColor="#00FFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="10dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:id="@+id/gateButtonContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IC models"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/icModelButtonContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btnRemoveIc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remove"
                        android:textAllCaps="false"
                        android:textColor="#FF6B6B"
                        android:backgroundTint="#222222"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Expanded Truth Table Panel -->
    <FrameLayout
        android:id="@+id/truthTableOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:background="@android:color/transparent">

        <ScrollView
            android:id="@+id/truthTablePanelScroll"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="20dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="40dp"
            android:fillViewport="true"
            android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/truthTablePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/truth_table_panel_bg">

            <TextView
                android:id="@+id/txtTruthTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Truth Table"
                android:textColor="#00FFFF"
                android:textStyle="bold"
                android:textSize="18sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fillViewport="true"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/txtTruthContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:typeface="monospace" />
            </HorizontalScrollView>
        </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Floating buttons at the far right -->
    <ScrollView
        android:id="@+id/buttonPanelScroll"
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/buttonPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="10dp"
            android:background="@android:color/transparent">

        <!-- Torch -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="20dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnTorch"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_flash_off"
                android:tint="#FFFFFF"
                android:contentDescription="Toggle Flash"
                app:fabCustomSize="64dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Flash"
                android:textColor="#00FFCC"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Truth Table -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="20dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnTruthTable"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_table"
                android:tint="#FFFFFF"
                android:contentDescription="Truth Table"
                app:fabCustomSize="64dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Truth"
                android:textColor="#00FFCC"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Circuit -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="20dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnCircuit"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_circuit"
                android:tint="#00FFCC"
                android:contentDescription="Circuit Diagram Layer"
                app:fabCustomSize="64dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Circuit"
                android:textColor="#00FFCC"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Detect -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="20dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnDetection"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_detection"
                android:tint="#00FFCC"
                android:contentDescription="Detection Layer"
                app:fabCustomSize="64dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Detect"
                android:textColor="#00FFCC"
                android:textSize="12sp" />
        </LinearLayout>
        </LinearLayout>
    </ScrollView>

</FrameLayout>