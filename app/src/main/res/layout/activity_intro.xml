<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#FFFFFF"
    android:padding="32dp"
    android:gravity="center">

    <!-- LEFT SIDE -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:src="@drawable/logo_arcuit"
            android:contentDescription="ARCUIT Logo" />

    </LinearLayout>

    <!-- RIGHT SIDE -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="28dp"
        android:background="@drawable/bg_intro_card"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/appSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Augmented Reality-Based Logic Circuits Implementation Checker"
            android:textSize="16sp"
            android:textColor="#4E6B78"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="28dp" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Initializing system..."
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#008DB3"
            android:layout_marginBottom="12dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="300dp"
            android:layout_height="12dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#00B7E8"
            android:progressBackgroundTint="#D9EEF5" />

        <TextView
            android:id="@+id/progressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#062B3D"
            android:layout_marginTop="14dp" />

    </LinearLayout>

</LinearLayout>